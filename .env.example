# --- Matrix-Zugang -----------------------------------------------------------
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER=@musikbot:example.org
# Entweder Passwort ODER Token (Token empfohlen, Device-ID dazu notieren)
MATRIX_PASSWORD=
MATRIX_TOKEN=
MATRIX_DEVICE_ID=musikbot

# Raeume als ID (!abc:server) oder Alias (#musik:server), kommagetrennt.
MATRIX_ROOMS=#musik:example.org
# Wer darf kommandieren? Kommagetrennt; leer = alle Raummitglieder.
ALLOWED_USERS=

# --- Songlimit ---------------------------------------------------------------
# Laengere Titel werden abgelehnt (Sekunden, 0 = kein Limit).
MAX_SONG_SECONDS=600
# Groesste Datei, die als Chat-Anhang abgespielt wird (MB)
MAX_UPLOAD_MB=100
# Call automatisch verlassen, wenn so viele Sekunden nichts spielt (0 = nie)
IDLE_LEAVE_SECONDS=60
# Call sofort verlassen, wenn der Song zu Ende und die Warteschlange leer ist
# (nicht im 24/7-Modus):
LEAVE_WHEN_DONE=true
# Nur Leute, die selbst im Call sind, duerfen den Bot steuern:
CALL_ONLY_CONTROL=true
# Weiche Ueberblendung zwischen Titeln der Warteschlange (Sekunden, 0 = aus).
# Der naechste Titel wird dafuer ca. 45 s vorher schon geladen.
CROSSFADE_SECONDS=6

# --- Video -------------------------------------------------------------------
ENABLE_VIDEO=true
VIDEO_HEIGHT=480
VIDEO_FPS=24
VIDEO_BITRATE=600000

# --- Calls -------------------------------------------------------------------
# Bot nimmt Calls automatisch an:
AUTO_ANSWER=true
# auto = bei Gruppen-Calls alle Raum-Mitglieder einladen (Mesh),
# all = immer alle, off = nie selbst einladen.
MESH_INVITE=auto
# Verschluesselte Raeume (E2EE) nutzen:
ENCRYPTION_ENABLED=true
# Ephemere TURN-Credentials vom Homeserver holen (empfohlen bei NAT):
TURN_DISCOVERY=true
# Statisches TURN (nur noetig, wenn der Homeserver keins anbietet):
TURN_URIS=
TURN_USERNAME=
TURN_PASSWORD=

# --- yt-dlp ------------------------------------------------------------------
# Falls YouTube blockt: tv/android/ios testen, z.B.
#YTDLP_PLAYER_CLIENT=tv
# Cookies aus Browser-Export gegen Age/Bot-Walls:
#YTDLP_COOKIES_FILE=/data/cookies.txt

# --- Sonstiges ---------------------------------------------------------------
LOG_LEVEL=INFO
# Pfad IM Container. Liegt im Docker-Volume 'musikbot_data' (siehe compose-Datei) –
# dort nicht aendern, sonst findest du die Dateien nicht wieder.
DATA_DIR=/data

# --- Radio -------------------------------------------------------------------
# Ordner IM Container; auf dem Host ist es ./radio (siehe compose.yaml). Dort MP3s ablegen.
RADIO_DIR=/radio
